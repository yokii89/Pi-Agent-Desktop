{
  "name": "pidesk",
  "productName": "PiDesk",
  "version": "0.4.1",
  "description": "Windows desktop client for pi",
  "author": "yecen",
  "main": "dist/main/index.js",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:view": "node scripts/sync-view-sdk-types.mjs --check && pnpm run build:view-sdk && vitest run --config packages/view-sdk/vitest.config.ts && vitest run --config src/main/vitest.config.ts && vitest run --config src/renderer/vitest.config.ts",
    "sync:view-types": "node scripts/sync-view-sdk-types.mjs",
    "check:view-types": "node scripts/sync-view-sdk-types.mjs --check",
    "gen:file-icons": "node scripts/generate-file-icons.mjs",
    "gen:app-icon": "node scripts/generate-app-icon.mjs",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "start": "pnpm run build && electron .",
    "dist": "node scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "test:sdk:coverage": "vitest run --config packages/view-sdk/vitest.config.ts --coverage && node scripts/sdk-coverage-snapshot.mjs",
    "check:sdk-cross": "node scripts/check-sdk-cross.mjs",
    "build:view-sdk": "tsc -p packages/view-sdk/tsconfig.build.json",
    "check:sdk-consumer": "node scripts/check-sdk-consumer.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "gsap": "^3.15.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
